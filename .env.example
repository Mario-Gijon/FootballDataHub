# Root project-relative directory containing the CLAS-01/CLAS-01B exports.
FDH_DATA_ROOT=data/exports/bdfutbol/group2_classification

# Each path is relative to FDH_DATA_ROOT, or may be an absolute path.
FDH_GROUP2_MATCHES=derived-res01-20261010T102656Z/normalized/matches.json
FDH_GROUP2_CLASSIFICATION=20261010T102656.252222Z-72f200ad/normalized/classification.json
FDH_GROUP2_PROGRESS=20261010T102656.252222Z-72f200ad/normalized/progress.json
FDH_GROUP2_CAPTURE_METADATA=20261010T102656.252222Z-72f200ad/metadata/capture.json

# Group I captures are explicit; the API never chooses the newest directory.
FDH_GROUP1_DATA_ROOT=data/exports/bdfutbol/group1_classification
FDH_GROUP1_CAPTURE_ROOT=20261010T202500.293648Z-b770724f
FDH_GROUP1_TOP_ROOT=data/exports/bdfutbol/group1_top/20261010T202506.237287Z-c92b19fb
FDH_GROUP1_STATISTICS_ROOT=data/exports/bdfutbol/group1_statistics/20261010T202515.613199Z-6c6e0fd9

# One shared, versioned REF-01 capture used by both groups' referee routes.
FDH_REFEREES_ROOT=data/exports/bdfutbol/group2_referees/20261010T171227.617128Z-4cfe71bc
# Backward compatible alias for FDH_REFEREES_ROOT:
# FDH_GROUP2_REFEREES_ROOT=data/exports/bdfutbol/group2_referees/20261010T171227.617128Z-4cfe71bc
# Optional override for the Group II relation; Group I uses its own capture report.
# FDH_GROUP2_REFEREES_MATCHES=data/exports/bdfutbol/group2_classification/derived-res01-20261010T102656Z/normalized/matches.json

# Independent STAT-01 capture used by /api/v1/group2/statistics/bootstrap.
FDH_GROUP2_STATISTICS_ROOT=data/exports/bdfutbol/group2_statistics/20261010T182210.859321Z-28543363

# Empty disables cross-origin browser requests. Add the future dashboard origin explicitly.
FDH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
