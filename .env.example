# Root project-relative directory containing the CLAS-01/CLAS-01B exports.
FDH_DATA_ROOT=data/exports/bdfutbol/group2_classification

# Each path is relative to FDH_DATA_ROOT, or may be an absolute path.
FDH_GROUP2_MATCHES=derived-clas01b-20261010T102656Z/normalized/matches.json
FDH_GROUP2_CLASSIFICATION=20261010T102656.252222Z-72f200ad/normalized/classification.json
FDH_GROUP2_PROGRESS=20261010T102656.252222Z-72f200ad/normalized/progress.json
FDH_GROUP2_CAPTURE_METADATA=20261010T102656.252222Z-72f200ad/metadata/capture.json

# Independent, versioned REF-01 capture used by /api/v1/group2/referees/bootstrap.
FDH_GROUP2_REFEREES_ROOT=data/exports/bdfutbol/group2_referees/20261010T171227.617128Z-4cfe71bc
# Optional override. If omitted, the relation path declared by REF-01 is resolved from the project root.
# FDH_GROUP2_REFEREES_MATCHES=data/exports/bdfutbol/group2_classification/derived-res01-20261010T102656Z/normalized/matches.json

# Empty disables cross-origin browser requests. Add the future dashboard origin explicitly.
FDH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
