{
  "schema_version": "football_data_hub.bdfutbol.discovery.relationship_catalog.v1",
  "identity_policy": "Preserve BDFutbol IDs, raw href, row/column coordinates and provenance; do not merge names alone or infer transfers solely from multiple same-season memberships.",
  "edges": [
    {
      "edge_id": "competition.includes_team_season",
      "from": "competition(season,group)",
      "to": "team_season(tID)",
      "observed": "40 participants, 20 per group",
      "status": "NORMALIZED",
      "evidence": "data/parsed/bdfutbol/primera_federacion_2026_27/snapshot-044edc9b2ef3c6026c7f-parser-1.0.0/participants.json"
    },
    {
      "edge_id": "competition.schedules_match",
      "from": "competition(group,round)",
      "to": "match(match_id)",
      "observed": "760 scheduled fixtures; 119 played in each group at capture time",
      "status": "NORMALIZED",
      "evidence": "data/parsed/bdfutbol/primera_federacion_2026_27/snapshot-044edc9b2ef3c6026c7f-parser-1.0.0/matches_group_i.json and matches_group_ii.json"
    },
    {
      "edge_id": "team_season.club",
      "from": "team_season(tID)",
      "to": "club(eID)",
      "observed": "40 team IDs / 40 verified permanent club IDs",
      "status": "NORMALIZED",
      "evidence": "docs/hito_1d_b1_40_clubs_capture.md"
    },
    {
      "edge_id": "team_season.player_membership",
      "from": "team_season(tID)",
      "to": "player(jID) via membership",
      "observed": "1,039 memberships / 1,034 unique player IDs / 179 zero-appearance membership rows",
      "status": "NORMALIZED",
      "evidence": "club_team compact sports rosters/player_statistics exports"
    },
    {
      "edge_id": "team_season.coach",
      "from": "team_season(tID)",
      "to": "coach(lID)",
      "observed": "41 membership rows/IDs in sports export; not a count of full profile histories",
      "status": "RAW_PRESERVED",
      "evidence": "club_team compact sports/coaches_current.json.gz"
    },
    {
      "edge_id": "team_season.match_tracking",
      "from": "team_season(tID)",
      "to": "match(match_id)",
      "observed": "Match links and per-round raw tracking cells; two tracking pages lack header 5",
      "status": "RAW_PRESERVED",
      "evidence": "club_team compact sports/tracking_player_rows.json.gz; docs/hito_1d_b2_sports_data.md"
    },
    {
      "edge_id": "club.match_observation",
      "from": "club(eID)",
      "to": "match(match_id)",
      "observed": "17 valid all variants yielded 68 unique played match IDs; 51 of 119 competition-played IDs not observed in those variants",
      "status": "NORMALIZED",
      "evidence": "club_team compact sports/matches_played.json.gz and match_observations.json.gz"
    },
    {
      "edge_id": "match.home_away",
      "from": "match(match_id)",
      "to": "team_season(tID)",
      "observed": "Two sides on parsed result rows where links exist",
      "status": "NORMALIZED",
      "evidence": "competition and club/team exports"
    },
    {
      "edge_id": "match.stadium",
      "from": "match(match_id)",
      "to": "stadium(id)",
      "observed": "Venue links/text occur in fixture and club-match tables; historical venue reconciliation pending",
      "status": "RAW_PRESERVED",
      "evidence": "competition and club/team rendered DOM snapshots"
    },
    {
      "edge_id": "match.referee",
      "from": "match(match_id)",
      "to": "referee(rID)",
      "observed": "Referee names/links present on some schedule/detail rows; full completeness not tested",
      "status": "RAW_PRESERVED",
      "evidence": "competition schedule and match_269462 snapshots"
    },
    {
      "edge_id": "player.trajectory",
      "from": "player(jID)",
      "to": "team_season(tID)",
      "observed": "Morillas: 3 career rows plus total, 26 raw columns; remaining histories uncaptured",
      "status": "RAW_PRESERVED",
      "evidence": "player 0.2.1 trajectory.json.gz"
    },
    {
      "edge_id": "player.rival",
      "from": "player(jID)",
      "to": "player(jID)",
      "observed": "533 rival records from Morillas only",
      "status": "NORMALIZED",
      "evidence": "player 0.2.1 rivals.json.gz"
    },
    {
      "edge_id": "club.historical_team_season",
      "from": "club(eID)",
      "to": "team_season(tID)",
      "observed": "2,580 relationship occurrences across 40 permanent-club profiles; occurrence total, not unique entity count",
      "status": "RAW_PRESERVED",
      "evidence": "club_team compact resource catalog"
    },
    {
      "edge_id": "club.rival_history",
      "from": "club(eID)",
      "to": "club/player/coach",
      "observed": "40 rival view snapshots with cross-history links",
      "status": "RAW_PRESERVED",
      "evidence": "club_team compact resource catalog"
    },
    {
      "edge_id": "page.media_reference",
      "from": "page/entity",
      "to": "image URL",
      "observed": "Image attrs recorded; 150,539 aggregate repeated DOM candidates across 531 pages, not unique media",
      "status": "RAW_PRESERVED",
      "evidence": "raw inventory.json and summary.json"
    }
  ],
  "multi_membership_examples": [
    {
      "player_id": "j23751",
      "memberships": [
        "UD Logroñés",
        "UD Ibiza"
      ],
      "state": "ARTIFACT_ONLY",
      "note": "Preserve separate membership rows; do not infer a confirmed transfer from two season entries."
    },
    {
      "player_id": "j26481",
      "memberships": [
        "Sant Andreu",
        "Huesca"
      ],
      "state": "ARTIFACT_ONLY",
      "note": "One membership has no appearances; retain it."
    },
    {
      "player_id": "j100160",
      "memberships": [
        "Real Unión"
      ],
      "state": "ARTIFACT_ONLY",
      "note": "Roster membership only; individual career remains unacquired."
    }
  ],
  "caveats": [
    "Provider IDs are not cross-provider global IDs.",
    "Rival and historical-season links are not necessarily 2026/27 relationships.",
    "Absence of a link is not proof that a target entity is absent.",
    "Names/aliases may differ between roster, profile and career pages."
  ]
}
